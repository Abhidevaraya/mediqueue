# ==============================================================================
# MediQueue — Environment Configuration Template (Phases 1 - 5)
# Copy this file to .env or set environment variables in your deployment orchestrator.
# NEVER commit production credentials or secrets to version control.
# ==============================================================================

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080
HOSPITAL_TIMEZONE=Asia/Kolkata

# MySQL Database Configuration (MySQL 8.x)
DB_URL=jdbc:mysql://localhost:3306/mediqueue_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here

# Test Database (used when running integration tests with test profile)
DB_TEST_URL=jdbc:mysql://localhost:3306/mediqueue_test?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=your_secure_test_db_password_here

# JWT Security Configuration (HMAC-SHA256, minimum 256 bits / 32 characters)
JWT_SECRET=replace_with_a_secure_256_bit_secret_key_minimum_32_chars
JWT_ACCESS_TOKEN_EXPIRATION=86400000

# CORS Allowed Frontend Origins (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Medical Document Storage Configuration
MEDIQUEUE_DOCUMENT_STORAGE_PATH=storage/documents
MEDIQUEUE_DOCUMENT_MAX_SIZE=10MB
MEDIQUEUE_DOCUMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png

# Optional First Administrator Bootstrap (Provisioned once at startup if no admin exists)
ADMIN_BOOTSTRAP_EMAIL=admin@mediqueue.com
ADMIN_BOOTSTRAP_PASSWORD=ReplaceWithStrongBootstrapPassword!2026
ADMIN_BOOTSTRAP_NAME=System Administrator

