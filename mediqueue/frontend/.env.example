# ==============================================================================
# MediQueue Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL (HTTP/HTTPS base endpoint, without trailing slash)
# The STOMP WebSocket connection automatically derives from this host (e.g. ws://localhost:8080/ws)
VITE_API_BASE_URL=http://localhost:8080

# Environment Profile ('development' | 'production' | 'test')
VITE_APP_ENV=development
